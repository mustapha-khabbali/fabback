rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny-all (2026-07-09, ENGINEERING_CLEANUP.md Phase 0.4).
    // The data plane is PostgreSQL behind fablab-api; Firebase is used for
    // Auth + Hosting only. No client reads or writes Firestore anymore.
    // If a collection is ever needed again, open access for exactly that
    // collection — never globally.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
