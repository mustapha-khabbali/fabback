# School-server deployment env — see DEPLOYMENT_DAY.md for the full checklist.
# Copy to .env on the server and replace every "change-this" value.

# DNS name of the API server (the A record school IT created)
API_DOMAIN=api.YOUR-SCHOOL-DOMAIN.ma
USER_HOSTING_DOMAIN=fablab-bmk.web.app
ADMIN_HOSTING_DOMAIN=fablab-cmc.web.app
# Only used by the all-in-one (non-Firebase) hosting mode:
MAIN_DOMAIN=app.YOUR_DOMAIN
ADMIN_DOMAIN=admin.YOUR_DOMAIN
# Real mailbox — Let's Encrypt sends cert-expiry warnings here
LETSENCRYPT_EMAIL=it@cmc.ma

POSTGRES_DB=fablab
POSTGRES_USER=fablab
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-this-postgres-password

# Generate: openssl rand -hex 48
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=7d
# New admin credentials — seeding these ROTATES any previously used ones
ADMIN_SEED_EMAIL=sara.admin@fablab.local
ADMIN_SEED_PASSWORD=change-this-admin-password
FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json

# Lab opening hours (HH:MM, Africa/Casablanca). Gate-IN is refused outside
# these hours ("Le FabLab est fermé"); EVENT scans are exempt; check-out is
# never blocked. Open attendances auto-close at closing time.
# LAB_OPEN_TIME=08:30
# LAB_CLOSE_TIME=18:30

VITE_API_URL=https://API_DOMAIN/api
